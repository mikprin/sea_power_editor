<Viewbox Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">
	<!-- Canvas is 1140 x 620. The tactical plot occupies 810 x 540 at the
	     origin; the strip to the right of x=820 is the intelligence annex
	     and the strip below y=550 is the task force summary. -->
	<Canvas Width="1140" Height="620">
		<!-- Open ocean. No coastline anywhere in this playfield, so the base
		     image is a plain graticule at 10 NM spacing.
		     810 x 540 px = 90 x 60 NM at 9 px per NM, covering
		     NM X -20..70, Z -90..-30.
		     Canvas.Left = (X_nm + 20) * 9   Canvas.Top = (-30 - Z_nm) * 9 -->
		<Image Source="{Binding Assets[02_arabian_sea]}"/>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ЦЕНТРАЛЬНАЯ ЧАСТЬ АРАВИЙСКОГО МОРЯ" FontSize="13" FontWeight="Bold" Opacity="0.55" Canvas.Left="20" Canvas.Top="500"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="сетка 10 миль - суши нет в радиусе 200 миль" FontSize="11" FontStyle="Italic" Opacity="0.45" Canvas.Left="20" Canvas.Top="520"/>

		<!-- Transit lane, course 113, from the Pandora's start to Keystone -->
		<Path Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="3" StrokeDashArray="4 3"
		      Data="M 139 136 L 222 171 L 305 207 L 387 242 L 437 263"/>

		<!-- Deployment holding box: NM X -16..4, Z -55..-35 -->
		<Border Canvas.Left="36" Canvas.Top="45" Width="180" Height="180"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ЗОНА РАЗВЁРТЫВАНИЯ" FontSize="14" FontWeight="Bold" Canvas.Left="44" Canvas.Top="51"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="{TaskForceName}" FontSize="12" Canvas.Left="44" Canvas.Top="71"/>

		<!-- MV PANDORA at her start position: NM (-4.58, -45.14) -->
		<StackPanel Orientation="Vertical" Canvas.Left="105" Canvas.Top="105">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontWeight="Bold" Text="MV PANDORA"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.FriendColour}" Data="{StaticResource NTDS.Allied.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.FriendColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontSize="11" Text="без вооружения - максимум 20 узлов"/>
		</StackPanel>

		<!-- NAVPOINT KEYSTONE: NM (28.56, -59.2) radius 6 NM = 54 px -->
		<Ellipse Canvas.Left="383" Canvas.Top="209" Width="108" Height="108"
		         Opacity="0.30" Fill="{StaticResource NTDS.FriendColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="NAVPOINT KEYSTONE" FontSize="14" FontWeight="Bold" Canvas.Left="378" Canvas.Top="322"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="точка сдачи - международные воды" FontSize="11" Canvas.Left="378" Canvas.Top="341"/>

		<!-- Phase gates along the lane -->
		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="НАЧАЛО РЭБ" FontSize="11" FontWeight="Bold" Canvas.Left="196" Canvas.Top="146"/>
		<TextBlock Foreground="{StaticResource NTDS.HostileColour}" Text="ПЕРЕХВАТ" FontSize="11" FontWeight="Bold" Canvas.Left="278" Canvas.Top="182"/>
		<TextBlock Foreground="{StaticResource NTDS.HostileColour}" Text="РАКЕТНАЯ УГРОЗА" FontSize="11" FontWeight="Bold" Canvas.Left="336" Canvas.Top="217"/>

		<!-- Decoy swarm belt, centred NM (29, -55) -->
		<Ellipse Canvas.Left="330" Canvas.Top="90" Width="270" Height="290"
		         Opacity="0.14" Fill="{StaticResource NTDS.UnknownColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="НАДВОДНАЯ КАРТИНА ЗАСВЕЧЕНА" FontSize="12" FontWeight="Bold" Canvas.Left="380" Canvas.Top="112"/>
		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="контакты не разрешаются - опознавание недостоверно" FontSize="10" Canvas.Left="380" Canvas.Top="130"/>
		<StackPanel Orientation="Vertical" Canvas.Left="432" Canvas.Top="216">
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.UnknownColour}" Data="{StaticResource NTDS.Unknown.Surface}"/>
			</Canvas>
		</StackPanel>

		<!-- Hound pack ALPHA - east: NM (48, -58) -->
		<StackPanel Orientation="Vertical" Canvas.Left="596" Canvas.Top="222">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="ГРУППА АЛЬФА"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Hound pack BRAVO - north east: NM (36, -38) -->
		<StackPanel Orientation="Vertical" Canvas.Left="488" Canvas.Top="42">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="ГРУППА БРАВО"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Hound pack CHARLIE - south east: NM (40, -74) -->
		<StackPanel Orientation="Vertical" Canvas.Left="522" Canvas.Top="366">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="ГРУППА ЧАРЛИ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Standoff jammer: NM (50, -50), 25000 ft -->
		<StackPanel Orientation="Vertical" Canvas.Left="614" Canvas.Top="150">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="САМОЛЁТ РЭБ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Air}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="большая высота - досягаем"/>
		</StackPanel>

		<!-- Syndicate support group: NM (55, -76) -->
		<StackPanel Orientation="Vertical" Canvas.Left="655" Canvas.Top="384">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="ГРУППА ОБЕСПЕЧЕНИЯ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="не подтверждено"/>
		</StackPanel>

		<!-- Missile carriers off the support group -->
		<StackPanel Orientation="Vertical" Canvas.Left="600" Canvas.Top="300">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="ВЕРТОЛЁТЫ-НОСИТЕЛИ ПКР"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Helicopter}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Threat axes onto the lane. Tool: https://yqnn.github.io/svg-path-editor/ -->
		<Path Canvas.Left="580" Canvas.Top="252" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform>
				<RotateTransform Angle="293"/>
			</Path.RenderTransform>
		</Path>
		<Path Canvas.Left="480" Canvas.Top="96" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform>
				<RotateTransform Angle="215"/>
			</Path.RenderTransform>
		</Path>
		<Path Canvas.Left="516" Canvas.Top="372" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform>
				<RotateTransform Angle="300"/>
			</Path.RenderTransform>
		</Path>

		<!-- ============================================================
		     INTELLIGENCE ANNEX - photo insets down the right hand edge.
		     Vanilla pattern from 05 Strike on the Monster: a white 5 px
		     border, a soft drop shadow and a small rotation, so the photo
		     reads as something pinned to the chart rather than drawn on it.
		     ============================================================ -->
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="СПРАВКА РАЗВЕДКИ - ПРЕЦЕДЕНТЫ" FontSize="13" FontWeight="Bold" Canvas.Left="826" Canvas.Top="6"/>

		<Border Canvas.Left="826" Canvas.Top="30" BorderThickness="5" BorderBrush="White">
			<Border.Effect>
				<DropShadowEffect Opacity="0.35"/>
			</Border.Effect>
			<Border.RenderTransform>
				<RotateTransform Angle="-1.5" CenterX="155" CenterY="105"/>
			</Border.RenderTransform>
			<Grid>
				<Image Stretch="Uniform" Source="{Binding Assets[02_intel_conveyor]}" Width="300"/>
			</Grid>
		</Border>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ATLANTIC CONVEYOR - 1982" FontSize="12" FontWeight="Bold" Canvas.Left="828" Canvas.Top="248"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="300" FontSize="10" Opacity="0.85" Canvas.Left="828" Canvas.Top="265"
		           Text="Корпус контейнеровоза, приваренная палуба, «Харриеры» на борту. Потоплен одной авиационной ракетой Exocet."/>

		<Border Canvas.Left="826" Canvas.Top="312" BorderThickness="5" BorderBrush="White">
			<Border.Effect>
				<DropShadowEffect Opacity="0.35"/>
			</Border.Effect>
			<Border.RenderTransform>
				<RotateTransform Angle="1.5" CenterX="155" CenterY="102"/>
			</Border.RenderTransform>
			<Grid>
				<Image Stretch="Uniform" Source="{Binding Assets[02_intel_yak38]}" Width="300"/>
			</Grid>
		</Border>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="«АГОСТИНЬО НЕТО» - 1984" FontSize="12" FontWeight="Bold" Canvas.Left="828" Canvas.Top="524"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="300" FontSize="10" Opacity="0.85" Canvas.Left="828" Canvas.Top="541"
		           Text="Советские испытания. Взлёт СВВП с палубы обычного коммерческого контейнеровоза. Идея не нова. Просто она никогда не продавалась."/>

		<!-- ============================================================
		     TASK FORCE SUMMARY - strip below the plot.
		     {TaskForceVesselSummaryRuns} is the vanilla token, used the same
		     way in 05 Strike on the Monster.
		     ============================================================ -->
		<Border Canvas.Left="10" Canvas.Top="556" Width="790" Height="52"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="6">
				<Run Text="{TaskForceName}:" TextDecorations="Underline"/><LineBreak/>
				{TaskForceVesselSummaryRuns}
			</TextBlock>
		</Border>
	</Canvas>
</Viewbox>
