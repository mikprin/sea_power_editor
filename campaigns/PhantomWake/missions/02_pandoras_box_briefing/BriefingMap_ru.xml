<Viewbox Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">
	<!-- Canvas is 1170 x 680. The plot occupies 840 x 600 at the origin;
	     the strip right of x=850 is the intelligence annex and the strip
	     below y=610 is the task force summary. -->
	<Canvas Width="1170" Height="680">
		<!-- Open ocean, no coastline anywhere in the playfield, so the base
		     image is a plain graticule at 10 NM spacing.
		     840 x 600 px = 140 x 100 NM at 6 px per NM, covering
		     NM X -20..120, Z -120..-20.
		     Canvas.Left = (X_nm + 20) * 6   Canvas.Top = (-20 - Z_nm) * 6 -->
		<Image Source="{Binding Assets[02_arabian_sea]}"/>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ЦЕНТРАЛЬНАЯ ЧАСТЬ АРАВИЙСКОГО МОРЯ" FontSize="12" FontWeight="Bold" Opacity="0.55" Canvas.Left="16" Canvas.Top="558"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="сетка 10 миль - суши нет в радиусе 200 миль" FontSize="10" FontStyle="Italic" Opacity="0.45" Canvas.Left="16" Canvas.Top="576"/>

		<!-- THE HANDOVER AREA: NM (67.35, -77.37) radius 40 NM = 240 px,
		     drawn at true scale. It is a large piece of international water
		     rather than a pinpoint, which is why the passage is about two
		     hours rather than four. -->
		<Ellipse Canvas.Left="284" Canvas.Top="104" Width="480" Height="480"
		         Opacity="0.20" Fill="{StaticResource NTDS.FriendColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="РАЙОН ПЕРЕДАЧИ" FontSize="15" FontWeight="Bold" Canvas.Left="470" Canvas.Top="360"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="при входе судно переходит компании" FontSize="10" Canvas.Left="470" Canvas.Top="380"/>

		<!-- Convoy track, the two authored waypoints. The circle bites at the
		     crossing mark, 38.8 NM out. -->
		<Path Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="3" StrokeDashArray="4 3"
		      Data="M 93 151 L 249 217 L 524 344"/>
		<Ellipse Canvas.Left="301" Canvas.Top="239" Width="10" Height="10" Fill="{StaticResource NTDS.FriendColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="38.8 мили" FontSize="10" Canvas.Left="286" Canvas.Top="222"/>

		<!-- Deployment box: NM X -12..8, Z -73.7..-23.7 -->
		<Border Canvas.Left="48" Canvas.Top="22" Width="120" Height="300"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="РАЗВЁРТЫВАНИЕ" FontSize="12" FontWeight="Bold" Canvas.Left="54" Canvas.Top="26"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="{TaskForceName}" FontSize="10" Canvas.Left="54" Canvas.Top="42"/>

		<!-- MV PANDORA at her start position: NM (-4.58, -45.14) -->
		<StackPanel Orientation="Vertical" Canvas.Left="60" Canvas.Top="122">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontWeight="Bold" FontSize="11" Text="MV PANDORA"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.FriendColour}" Data="{StaticResource NTDS.Allied.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.FriendColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontSize="10" Text="без вооружения - 20 узлов"/>
		</StackPanel>

		<!-- Hound pack ONE - east: NM (60, -57) -->
		<StackPanel Orientation="Vertical" Canvas.Left="464" Canvas.Top="192">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="СТАЯ ОДИН"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Hound pack TWO - south east: NM (42.23, -84.7) -->
		<StackPanel Orientation="Vertical" Canvas.Left="357" Canvas.Top="358">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="СТАЯ ДВА"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Hound pack THREE - east north east: NM (69.48, -59.64) -->
		<StackPanel Orientation="Vertical" Canvas.Left="521" Canvas.Top="208">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="СТАЯ ТРИ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Syndicate support group: NM (53.36, -76.24) -->
		<StackPanel Orientation="Vertical" Canvas.Left="424" Canvas.Top="307">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="ГРУППА ОБЕСПЕЧЕНИЯ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="10" Text="на борту вертолёты-носители ПКР"/>
		</StackPanel>

		<!-- Standoff jammer working area: NM (70, -45), 20000 ft -->
		<StackPanel Orientation="Vertical" Canvas.Left="524" Canvas.Top="120">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="11" Text="САМОЛЁТ РЭБ"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Air}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" FontSize="10" Text="большая высота - досягаем"/>
		</StackPanel>

		<!-- Converging axes. All three packs are already under way on these
		     bearings at mission start; the arrows point at where they are
		     going, which is the convoy, not at a fixed tripwire. -->
		<Path Canvas.Left="452" Canvas.Top="228" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform><RotateTransform Angle="260"/></Path.RenderTransform>
		</Path>
		<Path Canvas.Left="357" Canvas.Top="382" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform><RotateTransform Angle="330"/></Path.RenderTransform>
		</Path>
		<Path Canvas.Left="512" Canvas.Top="246" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform><RotateTransform Angle="255"/></Path.RenderTransform>
		</Path>

		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="ЛОЖНЫЕ ЦЕЛИ РАССЕЯНЫ ПО ВСЕМ ТРЁМ НАПРАВЛЕНИЯМ" FontSize="10" FontWeight="Bold" Canvas.Left="300" Canvas.Top="452"/>
		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="опознавание недостоверно до визуальной проверки" FontSize="10" Canvas.Left="300" Canvas.Top="470"/>

		<!-- ============================================================
		     INTELLIGENCE ANNEX - photo insets down the right hand edge.
		     Vanilla pattern from 05 Strike on the Monster: white 5 px
		     border, soft drop shadow, small rotation, so each reads as
		     something pinned to the chart rather than drawn on it.
		     ============================================================ -->
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="СПРАВКА РАЗВЕДКИ - ПРЕЦЕДЕНТЫ" FontSize="13" FontWeight="Bold" Canvas.Left="856" Canvas.Top="6"/>

		<Border Canvas.Left="856" Canvas.Top="30" BorderThickness="5" BorderBrush="White">
			<Border.Effect><DropShadowEffect Opacity="0.35"/></Border.Effect>
			<Border.RenderTransform><RotateTransform Angle="-1.5" CenterX="155" CenterY="105"/></Border.RenderTransform>
			<Grid><Image Stretch="Uniform" Source="{Binding Assets[02_intel_conveyor]}" Width="290"/></Grid>
		</Border>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ATLANTIC CONVEYOR - 1982" FontSize="12" FontWeight="Bold" Canvas.Left="858" Canvas.Top="240"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="290" FontSize="10" Opacity="0.85" Canvas.Left="858" Canvas.Top="258"
		           Text="Корпус контейнеровоза, приваренная палуба, «Харриеры» на борту. Потоплен одной авиационной ракетой Exocet."/>

		<Border Canvas.Left="856" Canvas.Top="310" BorderThickness="5" BorderBrush="White">
			<Border.Effect><DropShadowEffect Opacity="0.35"/></Border.Effect>
			<Border.RenderTransform><RotateTransform Angle="1.5" CenterX="155" CenterY="100"/></Border.RenderTransform>
			<Grid><Image Stretch="Uniform" Source="{Binding Assets[02_intel_yak38]}" Width="290"/></Grid>
		</Border>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="«АГОСТИНЬО НЕТО» - 1984" FontSize="12" FontWeight="Bold" Canvas.Left="858" Canvas.Top="510"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="290" FontSize="10" Opacity="0.85" Canvas.Left="858" Canvas.Top="528"
		           Text="Советские испытания. Взлёт СВВП с палубы обычного коммерческого контейнеровоза. Идея не нова. Просто она никогда не продавалась."/>

		<!-- ============================================================
		     TASK FORCE SUMMARY. {TaskForceVesselSummaryRuns} is the vanilla
		     token, used the same way in 05 Strike on the Monster.
		     ============================================================ -->
		<Border Canvas.Left="10" Canvas.Top="612" Width="820" Height="56"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="6">
				<Run Text="{TaskForceName}:" TextDecorations="Underline"/><LineBreak/>
				{TaskForceVesselSummaryRuns}
			</TextBlock>
		</Border>
	</Canvas>
</Viewbox>
