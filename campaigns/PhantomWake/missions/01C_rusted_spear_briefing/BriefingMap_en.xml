<Viewbox Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">
	<Canvas Width="810" Height="810">
		<!-- Base map generated from the game's own coastline.
		     810 x 810 px = 54 x 54 NM at 15 px per NM.
		     Canvas.Left = (X_nm + 14) * 15   Canvas.Top = (58 - Z_nm) * 15 -->
		<Image Source="{Binding Assets[01C_channel]}"/>

		<!-- Geography labels -->
		<TextBlock Foreground="Black" Text="TANZANIA" FontSize="16" FontWeight="Bold" Canvas.Left="30" Canvas.Top="410"/>
		<TextBlock Foreground="Black" Text="UNGUJA" FontSize="16" FontWeight="Bold" Canvas.Left="430" Canvas.Top="735"/>
		<TextBlock Foreground="Black" Text="PEMBA" FontSize="16" FontWeight="Bold" Canvas.Left="700" Canvas.Top="120"/>
		<TextBlock Foreground="Black" Text="ZANZIBAR CHANNEL" FontSize="13" FontStyle="Italic" Canvas.Left="115" Canvas.Top="665"/>
		<TextBlock Foreground="Black" Text="40 m" FontSize="12" FontStyle="Italic" Canvas.Left="155" Canvas.Top="685"/>

		<!-- Deployment holding area: NM X 2..26, Z 34..42 -->
		<Border Canvas.Left="240" Canvas.Top="240" Width="360" Height="120"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="HOLDING AREA" FontSize="14" FontWeight="Bold" Canvas.Left="250" Canvas.Top="246"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="{TaskForceName}" FontSize="13" Canvas.Left="250" Canvas.Top="266"/>

		<!-- NAVPOINT ZULU: NM (10,28) radius 4 NM = 60 px -->
		<Ellipse Canvas.Left="300" Canvas.Top="390" Width="120" Height="120"
		         Opacity="0.30" Fill="{StaticResource NTDS.FriendColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="NAVPOINT ZULU" FontSize="14" FontWeight="Bold" Canvas.Left="300" Canvas.Top="515"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="deep water shelf" FontSize="12" Canvas.Left="310" Canvas.Top="535"/>

		<!-- Regime picket line across the channel mouth: NM Z=20, X -6..6 -->
		<Ellipse Canvas.Left="135" Canvas.Top="555" Width="30" Height="30" Opacity="0.30" Fill="{StaticResource NTDS.HostileColour}"/>
		<Ellipse Canvas.Left="195" Canvas.Top="555" Width="30" Height="30" Opacity="0.30" Fill="{StaticResource NTDS.HostileColour}"/>
		<Ellipse Canvas.Left="255" Canvas.Top="555" Width="30" Height="30" Opacity="0.30" Fill="{StaticResource NTDS.HostileColour}"/>
		<Ellipse Canvas.Left="315" Canvas.Top="555" Width="30" Height="30" Opacity="0.30" Fill="{StaticResource NTDS.HostileColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.HostileColour}" Text="BLOCKADE - PICKET LINE" FontSize="14" FontWeight="Bold" Canvas.Left="120" Canvas.Top="600"/>
		<TextBlock Foreground="{StaticResource NTDS.HostileColour}" Text="4 x gun-armed patrol craft" FontSize="12" Canvas.Left="130" Canvas.Top="620"/>

		<!-- S-311 NYOKA holding position: NM (0,11) -->
		<StackPanel Orientation="Vertical" Canvas.Left="165" Canvas.Top="700">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" Text="S-311 NYOKA"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.FriendColour}" Data="{StaticResource NTDS.Allied.Submarine}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.FriendColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontSize="12" Text="surfaced - 16 kt max"/>
		</StackPanel>

		<!-- Regime coastal patrol squadron: NM (14,50) -->
		<StackPanel Orientation="Vertical" Canvas.Left="375" Canvas.Top="100">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="COASTAL SQUADRON"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Regime air patrol: NM (10,54) -->
		<StackPanel Orientation="Vertical" Canvas.Left="320" Canvas.Top="35">
			<TextBlock Foreground="{StaticResource NTDS.HostileColour}" TextAlignment="Center" Text="AIR PATROL - MI-14"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.HostileColour}" Data="{StaticResource NTDS.Enemy.Air}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.HostileColour}"/>
			</Canvas>
		</StackPanel>

		<!-- Threat axes. Tool for making paths: https://yqnn.github.io/svg-path-editor/ -->
		<Path Canvas.Left="480" Canvas.Top="210" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform>
				<RotateTransform Angle="200"/>
			</Path.RenderTransform>
		</Path>
		<Path Canvas.Left="330" Canvas.Top="150" Data="M 0 -7 L 10 10 L 4 10 L 4 60 L -4 60 L -4 10 L -10 10 Z" Fill="{StaticResource NTDS.HostileColour}">
			<Path.RenderTransform>
				<RotateTransform Angle="190"/>
			</Path.RenderTransform>
		</Path>

		<!-- Escort route: NYOKA (0,11) -> (1,19) -> (5,25) -> (9,27.5) -> ZULU -->
		<Path Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="3" StrokeDashArray="4 3"
		      Data="M 210 705 L 225 585 L 285 495 L 345 457"/>
	</Canvas>
</Viewbox>
