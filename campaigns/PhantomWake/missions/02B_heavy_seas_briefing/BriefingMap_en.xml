<Viewbox Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">
	<!-- Canvas is 1170 x 680. Plot occupies 720 x 576 at the origin; the
	     strip right of x=850 is the intelligence annex and the strip below
	     y=610 is the task force summary.

	     Open ocean, no coastline within 200 NM, so the graticule is drawn
	     in XAML rather than shipped as a background image.

	     Window: NM X -20..+20, Z -18..+14 at 18 px per NM.
	         Canvas.Left = (X_nm + 20) * 18
	         Canvas.Top  = (14 - Z_nm)  * 18

	     NOTHING ON THIS MAP REFERS TO THE DISTRESS DATUM. That subplot does
	     not exist until the radio intercept at T+5 min, and a marker here
	     would give it away before the player has left the deployment box.
	     The only nod to it is MT PETROCHEM CASTOR's last position report in
	     the annex, which reads as ordinary traffic until it does not. -->
	<Canvas Width="1170" Height="680">

		<!-- storm wash over the whole plot -->
		<Rectangle Canvas.Left="0" Canvas.Top="0" Width="720" Height="576"
		           Fill="{StaticResource NTDS.UnknownColour}" Opacity="0.07"/>

		<!-- graticule, 10 NM spacing -->
		<Line X1="0"   Y1="0" X2="0"   Y2="576" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="180" Y1="0" X2="180" Y2="576" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="360" Y1="0" X2="360" Y2="576" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="540" Y1="0" X2="540" Y2="576" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="720" Y1="0" X2="720" Y2="576" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="0" Y1="72"  X2="720" Y2="72"  Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="0" Y1="252" X2="720" Y2="252" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Line X1="0" Y1="432" X2="720" Y2="432" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="1" Opacity="0.22"/>
		<Rectangle Canvas.Left="0" Canvas.Top="0" Width="720" Height="576"
		           Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="2" Opacity="0.5"/>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="CENTRAL ARABIAN SEA - 12N 063E" FontSize="14" FontWeight="Bold" Opacity="0.6" Canvas.Left="14" Canvas.Top="534"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="graticule 10 NM - no land within 200 NM" FontSize="10" FontStyle="Italic" Opacity="0.45" Canvas.Left="14" Canvas.Top="552"/>

		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="TROPICAL DEPRESSION - STATIONARY OVER THE LANE" FontSize="14" FontWeight="Bold" Opacity="0.8" Canvas.Left="300" Canvas.Top="18"/>
		<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" Text="sea state 7 - visual range under 0.5 NM - no moon - passive sonar unusable" FontSize="10" Opacity="0.7" Canvas.Left="300" Canvas.Top="38"/>

		<!-- NAVPOINT HALCYON: NM (0, +9) radius 4 NM = 72 px -->
		<Ellipse Canvas.Left="288" Canvas.Top="18" Width="144" Height="144"
		         Opacity="0.20" Fill="{StaticResource NTDS.FriendColour}"/>
		<Ellipse Canvas.Left="288" Canvas.Top="18" Width="144" Height="144"
		         Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="2" Opacity="0.7"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="NAVPOINT HALCYON" FontSize="14" FontWeight="Bold" Canvas.Left="440" Canvas.Top="74"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="convoy exit - fee paid on arrival" FontSize="11" Canvas.Left="440" Canvas.Top="94"/>

		<!-- convoy track, tail of the column to the NavPoint -->
		<Path Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="3" StrokeDashArray="4 3"
		      Data="M 360 446 L 360 90"/>
		<Ellipse Canvas.Left="355" Canvas.Top="263" Width="10" Height="10" Fill="{StaticResource NTDS.FriendColour}"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="15.8 NM - about 70 min at 15 kt" FontSize="10" Canvas.Left="372" Canvas.Top="258"/>

		<!-- weather easing line, NM Z = +3 -->
		<Line X1="60" Y1="198" X2="660" Y2="198" Stroke="{StaticResource NTDS.FriendColour}" StrokeThickness="2" StrokeDashArray="2 6" Opacity="0.5"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="northern edge of the cell - sea comes off here" FontSize="10" FontStyle="Italic" Opacity="0.65" Canvas.Left="66" Canvas.Top="178"/>

		<!-- Deployment box: NM X -8..8, Z -15.5..-7.5 -->
		<Border Canvas.Left="216" Canvas.Top="387" Width="288" Height="144"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="DEPLOY" FontSize="12" FontWeight="Bold" Canvas.Left="222" Canvas.Top="391"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="{TaskForceName}" FontSize="10" Canvas.Left="222" Canvas.Top="407"/>

		<!-- HALCYON CONVOY. Three capesize bulkers in a loose column with the
		     small general cargo hull at the tail: NM (0,-9) (0.8,-9.9)
		     (-0.8,-9.9) (0,-10.8). Drawn as one group symbol plus a label
		     for the tail ship, which is the one the player has to think about. -->
		<StackPanel Orientation="Vertical" Canvas.Left="330" Canvas.Top="396">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontWeight="Bold" FontSize="11" Text="HALCYON CONVOY"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.FriendColour}" Data="{StaticResource NTDS.Allied.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.FriendColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Center" FontSize="10" Text="4 laden merchants - 15 kt"/>
		</StackPanel>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="MV SOUTHERN GANNET - tail" FontSize="10" FontWeight="Bold" Canvas.Left="378" Canvas.Top="442"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="8,000 t against 175,000 t on the others" FontSize="9" Opacity="0.8" Canvas.Left="378" Canvas.Top="456"/>

		<!-- MT BARRA HEAD hove to: NM (-15, +4) -->
		<StackPanel Orientation="Vertical" Canvas.Left="79" Canvas.Top="160">
			<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" TextAlignment="Center" FontSize="11" Text="MT BARRA HEAD"/>
			<Canvas Width="22.5" Height="22.5" HorizontalAlignment="Center">
				<Path StrokeThickness="{DynamicResource ContactIconThickness}" Stroke="{StaticResource NTDS.UnknownColour}" Data="{StaticResource NTDS.Unknown.Surface}"/>
				<Ellipse Canvas.Left="10" Canvas.Top="10" Width="3" Height="3" StrokeThickness="1.325" Stroke="{StaticResource NTDS.UnknownColour}"/>
			</Canvas>
			<TextBlock Foreground="{StaticResource NTDS.UnknownColour}" TextAlignment="Center" FontSize="10" Text="PetroChem - riding it out"/>
		</StackPanel>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="NO HOSTILE FORCE ASSESSED IN THIS SQUARE" FontSize="13" FontWeight="Bold" Canvas.Left="200" Canvas.Top="496"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="the only thing that can sink a ship tonight is the sea, or you" FontSize="10" Opacity="0.75" Canvas.Left="200" Canvas.Top="514"/>

		<!-- ============================================================
		     INTELLIGENCE ANNEX. Same pinned-photo treatment as Contract 02.
		     ============================================================ -->
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="ANNEX - TRAFFIC IN THE SQUARE" FontSize="13" FontWeight="Bold" Canvas.Left="856" Canvas.Top="6"/>

		<Border Canvas.Left="856" Canvas.Top="30" BorderThickness="5" BorderBrush="White">
			<Border.Effect><DropShadowEffect Opacity="0.35"/></Border.Effect>
			<Border.RenderTransform><RotateTransform Angle="-1.5" CenterX="155" CenterY="60"/></Border.RenderTransform>
			<Grid><Image Stretch="Uniform" Source="{Binding Assets[02B_tanker_castor]}" Width="290"/></Grid>
		</Border>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="MT PETROCHEM CASTOR" FontSize="12" FontWeight="Bold" Canvas.Left="858" Canvas.Top="152"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="290" FontSize="10" Opacity="0.85" Canvas.Left="858" Canvas.Top="170"
		           Text="T2 type product tanker, laden, eastbound. Thirty eight years old and forty two crew. Last position report 0140Z, six miles east of the lane. Nothing since, which in this weather means nothing at all."/>

		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" Text="MT BARRA HEAD" FontSize="12" FontWeight="Bold" Canvas.Left="858" Canvas.Top="244"/>
		<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" Width="290" FontSize="10" Opacity="0.85" Canvas.Left="858" Canvas.Top="262"
		           Text="Sister operator, very large crude carrier. Hove to fifteen miles west of the lane with the sea on her bow, waiting the cell out. She will be on your plot for most of the passage. She is not our contract and she does not need anything."/>

		<Border Canvas.Left="856" Canvas.Top="344" Width="300" Height="242"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextWrapping="Wrap" FontSize="11" Margin="8">
				<Run Text="WEATHER - 110200 TO 111000Z" FontWeight="Bold"/><LineBreak/>
				<LineBreak/>
				Sea state 7, confused, long swell on the beam.<LineBreak/>
				Wind SW, gusting 45 kt.<LineBreak/>
				Overcast, base below 1000 ft.<LineBreak/>
				Heavy continuous rain, embedded thunderstorms.<LineBreak/>
				Visual range under 0.5 NM. No moon.<LineBreak/>
				<LineBreak/>
				Surface search degraded by clutter to 6 NM.<LineBreak/>
				Passive sonar unusable.<LineBreak/>
				<LineBreak/>
				<Run Text="Easing to sea state 4 toward first light." FontStyle="Italic"/>
			</TextBlock>
		</Border>

		<!-- ============================================================
		     TASK FORCE SUMMARY.
		     ============================================================ -->
		<Border Canvas.Left="10" Canvas.Top="612" Width="820" Height="56"
		        BorderThickness="2" BorderBrush="{StaticResource NTDS.FriendColour}" Background="#22335577">
			<TextBlock Foreground="{StaticResource NTDS.FriendColour}" TextAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="6">
				<Run Text="{TaskForceName}:" TextDecorations="Underline"/><LineBreak/>
				{TaskForceVesselSummaryRuns}
			</TextBlock>
		</Border>
	</Canvas>
</Viewbox>
